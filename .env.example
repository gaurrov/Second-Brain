# --- Application ---
APP_NAME=Second Brain API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=secondbrain_db
# Optional: overrides the composed URL above if set
DATABASE_URL=

# --- JWT / Security ---
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- File storage ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_USE_HTTPS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents_kb
QDRANT_UPSERT_BATCH_SIZE=256

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=4096

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Groq (LLM generation) ---
# REQUIRED — sign up at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# When using Docker Compose (docker/docker-compose.yml):
#
#   1. Copy this file:  cp .env.example .env
#   2. Fill in secrets: GROQ_API_KEY, JWT_SECRET_KEY, POSTGRES_PASSWORD
#   3. Start:           cd docker && docker compose up --build -d
#
# The app service reads .env via env_file.  Container-internal hostnames
# (POSTGRES_HOST=postgres, QDRANT_HOST=qdrant, REDIS_HOST=redis) are set
# in docker-compose.yml and override the localhost defaults above.
#
# Alembic migrations run automatically on container startup via entrypoint.sh.
# Upload storage is persisted in the 'upload_data' Docker volume.
#
# Never commit .env to git — it is already in .gitignore.
# =============================================================================
